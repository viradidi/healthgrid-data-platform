{
  "name": "PL_MASTER",
  "properties": {
    "activities": [
      {
        "name": "Source to Silver Postgres",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "PL_SOURCE_TO_SILVER_MAIN",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "source_system": "neon_postgres",
            "adf_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Source to Silver ADLS csv",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "PL_SOURCE_TO_SILVER_MAIN",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "source_system": "adls_csv",
            "adf_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Run Gold only when both sources succeed",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Source to Silver Postgres",
            "dependencyConditions": [
              "Completed"
            ]
          },
          {
            "activity": "Source to Silver ADLS csv",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "expression": {
            "value": "@and(equals(activity('Source to Silver Postgres').Status,'Succeeded'),equals(activity('Source to Silver ADLS csv').Status,'Succeeded'))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Execute Silver to Gold",
              "type": "ExecutePipeline",
              "dependsOn": [],
              "policy": {
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "PL_SILVER_TO_GOLD",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": true,
                "parameters": {
                  "adf_run_id": {
                    "value": "@pipeline().RunId",
                    "type": "Expression"
                  }
                }
              }
            }
          ],
          "ifFalseActivities": []
        }
      },
      {
        "name": "Send Email",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Run Gold only when both sources succeed",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "policy": {
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "PL_SEND_EMAIL",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "adf_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "postgres_status": {
              "value": "@activity('Source to Silver Postgres').Status",
              "type": "Expression"
            },
            "adls_status": {
              "value": "@activity('Source to Silver ADLS csv').Status",
              "type": "Expression"
            },
            "gold_status": {
              "value": "@if(and(equals(activity('Source to Silver Postgres').Status,'Succeeded'),equals(activity('Source to Silver ADLS csv').Status,'Succeeded')),activity('Run Gold only when both sources succeed').Status,'SKIPPED_SOURCE_FAILURE')",
              "type": "Expression"
            }
          }
        }
      }
    ],
    "annotations": []
  }
}
