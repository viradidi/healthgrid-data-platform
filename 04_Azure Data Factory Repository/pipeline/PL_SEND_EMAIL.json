{
  "name": "PL_SEND_EMAIL",
  "properties": {
    "activities": [
      {
        "name": "Read All tables status",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "SELECT audit_id, adf_run_id, table_id, stage, status, records_written, start_time, end_time, created_timestamp\nFROM ctrl.audit_log\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\nORDER BY table_id, stage;",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "AzureSqlTable1",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Prepare Email body Header",
        "type": "SetVariable",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "variableName": "body_header",
          "value": {
            "value": "@concat('HealthGrid run status | PostgreSQL source-to-Silver: ', pipeline().parameters.postgres_status, ' | ADLS CSV source-to-Silver: ', pipeline().parameters.adls_status, ' | Gold stage: ', pipeline().parameters.gold_status, '. Table-level audit details follow.')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Prepare Email body Footer",
        "type": "SetVariable",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "variableName": "body_footer",
          "value": "For support, contact the platform owner."
        }
      },
      {
        "name": "Prepare Email Subject",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Check overall failed count",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "variableName": "email_subject",
          "value": {
            "value": "@{pipeline().globalParameters.env} | @{if(and(equals(pipeline().parameters.postgres_status,'Succeeded'),and(equals(pipeline().parameters.adls_status,'Succeeded'),and(equals(pipeline().parameters.gold_status,'Succeeded'),equals(activity('Check overall failed count').output.firstRow.count,0)))),'SUCCESS','FAILED')} | HEALTHGRID MASTER RUN",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Check overall failed count",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "select count(*) as count from ctrl.audit_log \nwhere adf_run_id='@{pipeline().parameters.adf_run_id}'\nand status != 'SUCCESS'",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "AzureSqlTable1",
            "type": "DatasetReference"
          }
        }
      },
      {
        "name": "Prepare Logic apps body",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Prepare Email Subject",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Prepare Email body Footer",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Prepare Email body Header",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Read All tables status",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "variableName": "logic_apps_body",
          "value": {
            "value": "{\n\"adf_run_id\":\"@{pipeline().parameters.adf_run_id}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"email_receipients\":\"@{pipeline().globalParameters.email_receipent}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_footer\":\"@{variables('body_footer')}\",\n\"pipeline_statuses\": {\n  \"postgres_source_to_silver\": \"@{pipeline().parameters.postgres_status}\",\n  \"adls_csv_source_to_silver\": \"@{pipeline().parameters.adls_status}\",\n  \"gold_stage\": \"@{pipeline().parameters.gold_status}\"\n},\n\"status_table\": @{activity('Read All tables status').output.value}\n}",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Send Email",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "Prepare Logic apps body",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "url": {
            "value": "@pipeline().globalParameters.logic_apps_url",
            "type": "Expression"
          },
          "body": {
            "value": "@variables('logic_apps_body')",
            "type": "Expression"
          },
          "httpRequestTimeout": "00:02:00"
        }
      }
    ],
    "parameters": {
      "adf_run_id": {
        "type": "string",
        "defaultValue": "75665097-3ceb-47cb-ab64-21ecc398576c"
      },
      "postgres_status": {
        "type": "string",
        "defaultValue": "NOT_PROVIDED"
      },
      "adls_status": {
        "type": "string",
        "defaultValue": "NOT_PROVIDED"
      },
      "gold_status": {
        "type": "string",
        "defaultValue": "NOT_PROVIDED"
      }
    },
    "variables": {
      "body_header": {
        "type": "String"
      },
      "email_subject": {
        "type": "String"
      },
      "logic_apps_body": {
        "type": "String"
      },
      "body_footer": {
        "type": "String"
      }
    },
    "annotations": []
  }
}
