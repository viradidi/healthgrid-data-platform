{
 "name": "PL_SOURCE_TO_SILVER_INNER",
 "properties": {
  "activities": [
   {
    "name": "Read Table Details",
    "type": "Lookup",
    "dependsOn": [],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 2,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "typeProperties": {
     "source": {
      "type": "AzureSqlSource",
      "sqlReaderQuery": {
       "value": "select * from ctrl.table_config WHERE table_id=@{pipeline().parameters.table_id}",
       "type": "Expression"
      },
      "queryTimeout": "02:00:00",
      "partitionOption": "None"
     },
     "dataset": {
      "referenceName": "AzureSqlTable1",
      "type": "DatasetReference"
     },
     "firstRowOnly": true
    }
   },
   {
    "name": "Set Start Time",
    "type": "SetVariable",
    "dependsOn": [],
    "policy": {
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "typeProperties": {
     "variableName": "start_time",
     "value": {
      "value": "@concat(formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss-fff'),'_',pipeline().parameters.adf_run_id)",
      "type": "Expression"
     }
    }
   },
   {
    "name": "Landing to Bronze",
    "type": "DatabricksNotebook",
    "dependsOn": [
     {
      "activity": "Check Source System",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 0,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "typeProperties": {
     "notebookPath": "/caresync-repo/caresync-adb-repo/Landing_to_Bronze",
     "baseParameters": {
      "source_system": {
       "value": "@activity('Read Table Details').output.firstRow.source_system",
       "type": "Expression"
      },
      "table_name": {
       "value": "@activity('Read Table Details').output.firstRow.bronze_table_name",
       "type": "Expression"
      },
      "landing_timestamp": {
       "value": "@variables('start_time')",
       "type": "Expression"
      },
      "source_file_format": {
       "value": "@coalesce(activity('Read Table Details').output.firstRow.source_file_format,'')",
       "type": "Expression"
      },
      "load_type": {
       "value": "@activity('Read Table Details').output.firstRow.load_type",
       "type": "Expression"
      }
     }
    },
    "linkedServiceName": {
     "referenceName": "LS_AzureDatabricks",
     "type": "LinkedServiceReference"
    }
   },
   {
    "name": "Bronze to Silver",
    "type": "DatabricksNotebook",
    "dependsOn": [
     {
      "activity": "Landing to Bronze",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 0,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "typeProperties": {
     "notebookPath": "/caresync-repo/caresync-adb-repo/Bronze_to_Silver",
     "baseParameters": {
      "table_name": {
       "value": "@activity('Read Table Details').output.firstRow.silver_table_name",
       "type": "Expression"
      },
      "landing_timestamp": {
       "value": "@variables('start_time')",
       "type": "Expression"
      },
      "merge_keys": {
       "value": "@coalesce(activity('Read Table Details').output.firstRow.merge_keys,'')",
       "type": "Expression"
      },
      "load_type": {
       "value": "@activity('Read Table Details').output.firstRow.load_type",
       "type": "Expression"
      },
      "landing_status": {
       "value": "@activity('Landing to Bronze').output.runOutput",
       "type": "Expression"
      }
     }
    },
    "linkedServiceName": {
     "referenceName": "LS_AzureDatabricks",
     "type": "LinkedServiceReference"
    }
   },
   {
    "name": "Update Success Status",
    "type": "Script",
    "dependsOn": [
     {
      "activity": "Checking Load Type and Update Watermark",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 2,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "linkedServiceName": {
     "referenceName": "LS_AzureSqlDatabase",
     "type": "LinkedServiceReference"
    },
    "typeProperties": {
     "scripts": [
      {
       "type": "Query",
       "text": {
        "value": "UPDATE ctrl.audit_log\nSET status = 'SUCCESS',\n    end_time = SYSUTCDATETIME(),\n    records_written = @{activity('Bronze to Silver').output.runOutput}\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND table_id = @{pipeline().parameters.table_id}\n  AND stage = 'SOURCE_TO_SILVER';\n\nIF @@ROWCOUNT <> 1\n    THROW 51020, 'Expected exactly one SOURCE_TO_SILVER audit row to be updated for this parent run and table.', 1;\n",
        "type": "Expression"
       }
      }
     ],
     "scriptBlockExecutionTimeout": "02:00:00"
    }
   },
   {
    "name": "Check load type",
    "type": "IfCondition",
    "dependsOn": [
     {
      "activity": "Read Table Details",
      "dependencyConditions": [
       "Succeeded"
      ]
     },
     {
      "activity": "Set Start Time",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "userProperties": [],
    "typeProperties": {
     "expression": {
      "value": "@and(equals(activity('Read Table Details').output.firstRow.source_system,'neon_postgres'),not(equals(activity('Read Table Details').output.firstRow.load_type,'FULL')))",
      "type": "Expression"
     },
     "ifTrueActivities": [
      {
       "name": "Read watermark",
       "type": "Lookup",
       "dependsOn": [],
       "policy": {
        "timeout": "0.12:00:00",
        "retry": 0,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
       },
       "userProperties": [],
       "typeProperties": {
        "source": {
         "type": "AzureSqlSource",
         "sqlReaderQuery": {
          "value": "select watermark_value from ctrl.watermark where table_id=@{pipeline().parameters.table_id}",
          "type": "Expression"
         },
         "queryTimeout": "02:00:00",
         "partitionOption": "None"
        },
        "dataset": {
         "referenceName": "AzureSqlTable1",
         "type": "DatasetReference"
        }
       }
      },
      {
       "name": "Store watermark value",
       "type": "SetVariable",
       "dependsOn": [
        {
         "activity": "Read watermark",
         "dependencyConditions": [
          "Succeeded"
         ]
        }
       ],
       "policy": {
        "secureOutput": false,
        "secureInput": false
       },
       "userProperties": [],
       "typeProperties": {
        "variableName": "watermarl_value",
        "value": {
         "value": "@activity('Read watermark').output.firstRow.watermark_value",
         "type": "Expression"
        }
       }
      }
     ]
    }
   },
   {
    "name": "Mark File Manifest Processed",
    "type": "Script",
    "dependsOn": [
     {
      "activity": "Bronze to Silver",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 2,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "linkedServiceName": {
     "referenceName": "LS_AzureSqlDatabase",
     "type": "LinkedServiceReference"
    },
    "typeProperties": {
     "scripts": [
      {
       "type": "Query",
       "text": {
        "value": "UPDATE ctrl.file_ingestion_manifest\nSET status = 'PROCESSED',\n    processed_timestamp = SYSUTCDATETIME(),\n    updated_timestamp = SYSUTCDATETIME(),\n    last_error = NULL\nWHERE table_id = @{pipeline().parameters.table_id}\n  AND adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND status = 'COPIED'",
        "type": "Expression"
       }
      }
     ],
     "scriptBlockExecutionTimeout": "02:00:00"
    }
   },
   {
    "name": "Checking Load Type and Update Watermark",
    "type": "IfCondition",
    "dependsOn": [
     {
      "activity": "Mark File Manifest Processed",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "userProperties": [],
    "typeProperties": {
     "expression": {
      "value": "@and(equals(activity('Read Table Details').output.firstRow.source_system,'neon_postgres'),not(equals(activity('Read Table Details').output.firstRow.load_type,'FULL')),not(equals(activity('Landing to Bronze').output.runOutput,'NO_DATA')))",
      "type": "Expression"
     },
     "ifTrueActivities": [
      {
       "name": "Update watermark",
       "type": "Script",
       "dependsOn": [],
       "policy": {
        "timeout": "0.12:00:00",
        "retry": 0,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
       },
       "userProperties": [],
       "linkedServiceName": {
        "referenceName": "LS_AzureSqlDatabase",
        "type": "LinkedServiceReference"
       },
       "typeProperties": {
        "scripts": [
         {
          "type": "Query",
          "text": {
           "value": "update ctrl.watermark\nset watermark_value=SYSUTCDATETIME()\nwhere table_id=@{pipeline().parameters.table_id}",
           "type": "Expression"
          }
         }
        ],
        "scriptBlockExecutionTimeout": "02:00:00"
       }
      }
     ]
    }
   },
   {
    "name": "Check Source System",
    "type": "Switch",
    "dependsOn": [
     {
      "activity": "Check load type",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "userProperties": [],
    "typeProperties": {
     "on": {
      "value": "@activity('Read Table Details').output.firstRow.source_system",
      "type": "Expression"
     },
     "cases": [
      {
       "value": "neon_postgres",
       "activities": [
        {
         "name": "Source to Landing Ingestion",
         "type": "Copy",
         "dependsOn": [],
         "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
         },
         "userProperties": [],
         "typeProperties": {
          "source": {
           "type": "PostgreSqlV2Source",
           "query": {
            "value": "SELECT * FROM \"@{activity('Read Table Details').output.firstRow.source_schema_name}\".\"@{activity('Read Table Details').output.firstRow.source_table_name}\"\n@{\n    if(equals(activity('Read Table Details').output.firstRow.load_type,'FULL')\n         ,'',\n         concat(\n            'WHERE \"',activity('Read Table Details').output.firstRow.watermark_column,'\" > ', '''',variables('watermarl_value'),''''\n         )\n    )\n}",
            "type": "Expression"
           },
           "queryTimeout": "02:00:00"
          },
          "sink": {
           "type": "ParquetSink",
           "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
           },
           "formatSettings": {
            "type": "ParquetWriteSettings"
           }
          },
          "enableStaging": false,
          "translator": {
           "type": "TabularTranslator",
           "typeConversion": true,
           "typeConversionSettings": {
            "allowDataTruncation": false,
            "treatBooleanAsNumber": false
           }
          }
         },
         "inputs": [
          {
           "referenceName": "DS_PostgreSql",
           "type": "DatasetReference"
          }
         ],
         "outputs": [
          {
           "referenceName": "DS_ADLS_Parquet",
           "type": "DatasetReference",
           "parameters": {
            "container": "landing",
            "folder": {
             "value": "@concat(\n    activity('Read Table Details').output.firstRow.source_system,\n    '/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
             "type": "Expression"
            }
           }
          }
         ]
        }
       ]
      },
      {
       "value": "adls_csv",
       "activities": [
        {
         "name": "List Source CSV Files",
         "type": "GetMetadata",
         "dependsOn": [],
         "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
         },
         "userProperties": [],
         "typeProperties": {
          "dataset": {
           "referenceName": "DS_Csv_Binary",
           "type": "DatasetReference",
           "parameters": {
            "folder": {
             "value": "@activity('Read Table Details').output.firstRow.source_path",
             "type": "Expression"
            },
            "container": "source"
           }
          },
          "fieldList": [
           "childItems"
          ],
          "storeSettings": {
           "type": "AzureBlobFSReadSettings",
           "recursive": false
          }
         }
        },
        {
         "name": "Filter CSV Files",
         "type": "Filter",
         "dependsOn": [
          {
           "activity": "List Source CSV Files",
           "dependencyConditions": [
            "Succeeded"
           ]
          }
         ],
         "userProperties": [],
         "typeProperties": {
          "items": {
           "value": "@activity('List Source CSV Files').output.childItems",
           "type": "Expression"
          },
          "condition": {
           "value": "@and(equals(item().type,'File'),endsWith(toLower(item().name),'.csv'))",
           "type": "Expression"
          }
         }
        },
        {
         "name": "Validate FULL CSV inventory",
         "type": "IfCondition",
         "dependsOn": [
          {
           "activity": "Filter CSV Files",
           "dependencyConditions": [
            "Succeeded"
           ]
          }
         ],
         "userProperties": [],
         "typeProperties": {
          "expression": {
           "value": "@and(equals(activity('Read Table Details').output.firstRow.load_type,'FULL'),equals(length(activity('Filter CSV Files').output.value),0))",
           "type": "Expression"
          },
          "ifTrueActivities": [
           {
            "name": "Fail Empty FULL CSV Source",
            "type": "Fail",
            "dependsOn": [],
            "userProperties": [],
            "typeProperties": {
             "message": "FULL CSV source folder contains no CSV files. Verify the configured source path and initial feed before processing.",
             "errorCode": "FULL_CSV_SOURCE_EMPTY"
            }
           }
          ],
          "ifFalseActivities": []
         }
        },
        {
         "name": "Ingest New CSV Files",
         "type": "ForEach",
         "dependsOn": [
          {
           "activity": "Validate FULL CSV inventory",
           "dependencyConditions": [
            "Succeeded"
           ]
          }
         ],
         "userProperties": [],
         "typeProperties": {
          "items": {
           "value": "@activity('Filter CSV Files').output.value",
           "type": "Expression"
          },
          "isSequential": true,
          "activities": [
           {
            "name": "Read Current File Metadata",
            "type": "GetMetadata",
            "dependsOn": [],
            "policy": {
             "timeout": "0.12:00:00",
             "retry": 1,
             "retryIntervalInSeconds": 30,
             "secureOutput": false,
             "secureInput": false
            },
            "userProperties": [],
            "typeProperties": {
             "dataset": {
              "referenceName": "DS_Csv_Binary_File",
              "type": "DatasetReference",
              "parameters": {
               "folder": {
                "value": "@activity('Read Table Details').output.firstRow.source_path",
                "type": "Expression"
               },
               "container": "source",
               "fileName": {
                "value": "@item().name",
                "type": "Expression"
               }
              }
             },
             "fieldList": [
              "size",
              "lastModified",
              "contentMD5"
             ],
             "storeSettings": {
              "type": "AzureBlobFSReadSettings"
             }
            }
           },
           {
            "name": "Check File Manifest",
            "type": "Lookup",
            "dependsOn": [
             {
              "activity": "Read Current File Metadata",
              "dependencyConditions": [
               "Succeeded"
              ]
             }
            ],
            "policy": {
             "timeout": "0.12:00:00",
             "retry": 1,
             "retryIntervalInSeconds": 30,
             "secureOutput": false,
             "secureInput": false
            },
            "userProperties": [],
            "typeProperties": {
             "source": {
              "type": "AzureSqlSource",
              "sqlReaderQuery": {
               "value": "SELECT\n    CASE WHEN EXISTS (\n        SELECT 1 FROM ctrl.file_ingestion_manifest\n        WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n          AND status = 'PROCESSED'\n    ) THEN CAST(1 AS INT) ELSE CAST(0 AS INT) END AS is_processed,\n    COALESCE((\n        SELECT TOP (1) status FROM ctrl.file_ingestion_manifest\n        WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n        ORDER BY file_manifest_id DESC\n    ), 'NEW') AS manifest_status,\n    COALESCE((\n        SELECT TOP (1) adf_run_id FROM ctrl.file_ingestion_manifest\n        WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n        ORDER BY file_manifest_id DESC\n    ), '') AS previous_run_id",
               "type": "Expression"
              },
              "queryTimeout": "02:00:00",
              "partitionOption": "None"
             },
             "dataset": {
              "referenceName": "AzureSqlTable1",
              "type": "DatasetReference"
             },
             "firstRowOnly": true
            }
           },
           {
            "name": "If File Needs Ingestion",
            "type": "IfCondition",
            "dependsOn": [
             {
              "activity": "Check File Manifest",
              "dependencyConditions": [
               "Succeeded"
              ]
             }
            ],
            "userProperties": [],
            "typeProperties": {
             "expression": {
              "value": "@equals(activity('Check File Manifest').output.firstRow.is_processed,0)",
              "type": "Expression"
             },
             "ifTrueActivities": [
              {
               "name": "Record File In Progress",
               "type": "Script",
               "dependsOn": [],
               "policy": {
                "timeout": "0.12:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
               },
               "userProperties": [],
               "linkedServiceName": {
                "referenceName": "LS_AzureSqlDatabase",
                "type": "LinkedServiceReference"
               },
               "typeProperties": {
                "scripts": [
                 {
                  "type": "Query",
                  "text": {
                   "value": "BEGIN TRY\n    BEGIN TRANSACTION;\n\n    IF EXISTS (\n        SELECT 1 FROM ctrl.file_ingestion_manifest\n        WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}' AND status = 'PROCESSED'\n    )\n        THROW 51001, 'This source file version was processed by another run. Refresh the manifest lookup and skip it.', 1;\n\n    IF EXISTS (\n        SELECT 1 FROM ctrl.file_ingestion_manifest\n        WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n          AND status IN ('IN_PROGRESS','COPIED')\n          AND adf_run_id <> '@{pipeline().parameters.adf_run_id}'\n    )\n        THROW 51002, 'This source file has an incomplete prior run. Reconcile its landing/Bronze/Silver state before retrying.', 1;\n\n    UPDATE ctrl.file_ingestion_manifest\n    SET status = 'IN_PROGRESS',\n        adf_run_id = '@{pipeline().parameters.adf_run_id}',\n        landing_path = N'@{concat(activity('Read Table Details').output.firstRow.source_system,'/',activity('Read Table Details').output.firstRow.source_table_name,'/',variables('start_time'))}',\n        last_error = NULL,\n        updated_timestamp = SYSUTCDATETIME()\n    WHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}';\n\n    IF @@ROWCOUNT = 0\n    BEGIN\n        INSERT INTO ctrl.file_ingestion_manifest\n        (\n            table_id, source_path, source_file_name, source_last_modified,\n            source_file_size, source_content_md5, status, adf_run_id, landing_path\n        )\n        VALUES\n        (\n            @{pipeline().parameters.table_id},\n            N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}',\n            N'@{replace(item().name,'''','''''')}',\n            CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7)),\n            @{activity('Read Current File Metadata').output.size},\n            N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}',\n            'IN_PROGRESS',\n            '@{pipeline().parameters.adf_run_id}',\n            N'@{concat(activity('Read Table Details').output.firstRow.source_system,'/',activity('Read Table Details').output.firstRow.source_table_name,'/',variables('start_time'))}'\n        );\n    END;\n\n    COMMIT TRANSACTION;\nEND TRY\nBEGIN CATCH\n    IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;\n    THROW;\nEND CATCH",
                   "type": "Expression"
                  }
                 }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
               }
              },
              {
               "name": "Copy CSV File to Landing",
               "type": "Copy",
               "dependsOn": [
                {
                 "activity": "Record File In Progress",
                 "dependencyConditions": [
                  "Succeeded"
                 ]
                }
               ],
               "policy": {
                "timeout": "0.12:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
               },
               "userProperties": [],
               "typeProperties": {
                "source": {
                 "type": "BinarySource",
                 "storeSettings": {
                  "type": "AzureBlobFSReadSettings",
                  "recursive": false,
                  "deleteFilesAfterCompletion": false
                 },
                 "formatSettings": {
                  "type": "BinaryReadSettings"
                 }
                },
                "sink": {
                 "type": "BinarySink",
                 "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                 }
                },
                "enableStaging": false
               },
               "inputs": [
                {
                 "referenceName": "DS_Csv_Binary_File",
                 "type": "DatasetReference",
                 "parameters": {
                  "folder": {
                   "value": "@activity('Read Table Details').output.firstRow.source_path",
                   "type": "Expression"
                  },
                  "container": "source",
                  "fileName": {
                   "value": "@item().name",
                   "type": "Expression"
                  }
                 }
                }
               ],
               "outputs": [
                {
                 "referenceName": "DS_Csv_Binary_File",
                 "type": "DatasetReference",
                 "parameters": {
                  "folder": {
                   "value": "@concat(activity('Read Table Details').output.firstRow.source_system,'/',activity('Read Table Details').output.firstRow.source_table_name,'/',variables('start_time'))",
                   "type": "Expression"
                  },
                  "container": "landing",
                  "fileName": {
                   "value": "@item().name",
                   "type": "Expression"
                  }
                 }
                }
               ]
              },
              {
               "name": "Mark File Copied",
               "type": "Script",
               "dependsOn": [
                {
                 "activity": "Copy CSV File to Landing",
                 "dependencyConditions": [
                  "Succeeded"
                 ]
                }
               ],
               "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
               },
               "userProperties": [],
               "linkedServiceName": {
                "referenceName": "LS_AzureSqlDatabase",
                "type": "LinkedServiceReference"
               },
               "typeProperties": {
                "scripts": [
                 {
                  "type": "Query",
                  "text": {
                   "value": "UPDATE ctrl.file_ingestion_manifest\nSET status = 'COPIED',\n    updated_timestamp = SYSUTCDATETIME(),\n    last_error = NULL\nWHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n  AND adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND status = 'IN_PROGRESS'",
                   "type": "Expression"
                  }
                 }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
               }
              },
              {
               "name": "Mark File Copy Failed",
               "type": "Script",
               "dependsOn": [
                {
                 "activity": "Copy CSV File to Landing",
                 "dependencyConditions": [
                  "Failed"
                 ]
                }
               ],
               "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
               },
               "userProperties": [],
               "linkedServiceName": {
                "referenceName": "LS_AzureSqlDatabase",
                "type": "LinkedServiceReference"
               },
               "typeProperties": {
                "scripts": [
                 {
                  "type": "Query",
                  "text": {
                   "value": "UPDATE ctrl.file_ingestion_manifest\nSET status = 'FAILED',\n    updated_timestamp = SYSUTCDATETIME(),\n    last_error = LEFT(N'@{replace(activity('Copy CSV File to Landing').error.message,'''','''''')}', 2000)\nWHERE table_id = @{pipeline().parameters.table_id}\nAND source_path = N'@{replace(activity('Read Table Details').output.firstRow.source_path,'''','''''')}'\nAND source_file_name = N'@{replace(item().name,'''','''''')}'\nAND source_last_modified = CAST(CONVERT(datetimeoffset(7), '@{activity('Read Current File Metadata').output.lastModified}') AS datetime2(7))\nAND source_file_size = @{activity('Read Current File Metadata').output.size}\nAND source_content_md5 = N'@{coalesce(activity('Read Current File Metadata').output.contentMD5,'')}'\n  AND adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND status = 'IN_PROGRESS'",
                   "type": "Expression"
                  }
                 }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
               }
              },
              {
               "name": "Fail CSV File Ingestion",
               "type": "Fail",
               "dependsOn": [
                {
                 "activity": "Mark File Copy Failed",
                 "dependencyConditions": [
                  "Completed"
                 ]
                }
               ],
               "userProperties": [],
               "typeProperties": {
                "message": "CSV file copy failed. The manifest records FAILED; inspect the Copy activity and retry after reconciliation.",
                "errorCode": "CSV_COPY_FAILED"
               }
              }
             ],
             "ifFalseActivities": []
            }
           }
          ]
         }
        }
       ]
      }
     ]
    }
   }
  ],
