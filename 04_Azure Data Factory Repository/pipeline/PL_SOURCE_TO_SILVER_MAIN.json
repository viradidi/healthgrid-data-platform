{
 "name": "PL_SOURCE_TO_SILVER_MAIN",
 "properties": {
  "activities": [
   {
    "name": "Read Source Tables List",
    "type": "Lookup",
    "dependsOn": [],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 2,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "userProperties": [],
    "typeProperties": {
     "source": {
      "type": "AzureSqlSource",
      "sqlReaderQuery": {
       "value": "select table_id from ctrl.table_config WHERE is_active=1 and source_system='@{pipeline().parameters.source_system}'",
       "type": "Expression"
      },
      "queryTimeout": "02:00:00",
      "partitionOption": "None"
     },
     "dataset": {
      "referenceName": "AzureSqlTable1",
      "type": "DatasetReference"
     },
     "firstRowOnly": false
    }
   },
   {
    "name": "Ingest All tables",
    "type": "ForEach",
    "dependsOn": [
     {
      "activity": "Read Source Tables List",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "userProperties": [],
    "typeProperties": {
     "items": {
      "value": "@activity('Read Source Tables List').output.value",
      "type": "Expression"
     },
     "isSequential": false,
     "activities": [
      {
       "name": "Ingest from Source to Silver",
       "type": "ExecutePipeline",
       "dependsOn": [
        {
         "activity": "Insert In Progress Status",
         "dependencyConditions": [
          "Succeeded"
         ]
        }
       ],
       "policy": {
        "secureInput": false
       },
       "userProperties": [],
       "typeProperties": {
        "pipeline": {
         "referenceName": "PL_SOURCE_TO_SILVER_INNER",
         "type": "PipelineReference"
        },
        "waitOnCompletion": true,
        "parameters": {
         "table_id": {
          "value": "@item().table_id",
          "type": "Expression"
         },
         "adf_run_id": {
          "value": "@pipeline().parameters.adf_run_id",
          "type": "Expression"
         }
        }
       }
      },
      {
       "name": "Insert In Progress Status",
       "type": "Script",
       "dependsOn": [],
       "policy": {
        "timeout": "0.12:00:00",
        "retry": 2,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
       },
       "userProperties": [],
       "linkedServiceName": {
        "referenceName": "LS_AzureSqlDatabase",
        "type": "LinkedServiceReference"
       },
       "typeProperties": {
        "scripts": [
         {
          "type": "Query",
          "text": {
           "value": "MERGE ctrl.audit_log WITH (HOLDLOCK) AS target\nUSING (\n    SELECT\n        '@{pipeline().parameters.adf_run_id}' AS adf_run_id,\n        @{item().table_id} AS table_id,\n        'SOURCE_TO_SILVER' AS stage\n) AS source\nON target.adf_run_id = source.adf_run_id\n   AND target.table_id = source.table_id\n   AND target.stage = source.stage\nWHEN MATCHED THEN\n    UPDATE SET\n        status = 'IN_PROGRESS',\n        records_written = NULL,\n        start_time = SYSUTCDATETIME(),\n        end_time = NULL\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (adf_run_id, table_id, stage, status, start_time)\n    VALUES (source.adf_run_id, source.table_id, source.stage, 'IN_PROGRESS', SYSUTCDATETIME());\n",
           "type": "Expression"
          }
         }
        ],
        "scriptBlockExecutionTimeout": "02:00:00"
       }
      },
      {
       "name": "Update Fialed Status",
       "type": "Script",
       "dependsOn": [
        {
         "activity": "Ingest from Source to Silver",
         "dependencyConditions": [
          "Failed"
         ]
        }
       ],
       "policy": {
        "timeout": "0.12:00:00",
        "retry": 2,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
       },
       "userProperties": [],
       "linkedServiceName": {
        "referenceName": "LS_AzureSqlDatabase",
        "type": "LinkedServiceReference"
       },
       "typeProperties": {
        "scripts": [
         {
          "type": "Query",
          "text": {
           "value": "UPDATE ctrl.audit_log\nSET status = 'FAILED',\n    end_time = SYSUTCDATETIME()\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND table_id = @{item().table_id}\n  AND stage = 'SOURCE_TO_SILVER';",
           "type": "Expression"
          }
         }
        ],
        "scriptBlockExecutionTimeout": "02:00:00"
       }
      },
      {
       "name": "Update pipeline as failed",
       "type": "Fail",
       "dependsOn": [
        {
         "activity": "Update Fialed Status",
         "dependencyConditions": [
          "Completed"
         ]
        }
       ],
       "userProperties": [],
       "typeProperties": {
        "message": "Inner pipeline failed",
        "errorCode": "500"
       }
      }
     ]
    }
   }
  ],
  "parameters": {
   "source_system": {
    "type": "string",
    "defaultValue": "adls_csv"
   },
   "adf_run_id": {
    "type": "string",
    "defaultValue": "a7"
   }
  },
  "variables": {
   "test": {
    "type": "String"
   }
  },
  "annotations": []
 }
}
